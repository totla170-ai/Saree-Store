# Copy this file to .env.local for local development.
# In production (Vercel), add these same names under Project Settings → Environment Variables.

# From Supabase: Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Make up your own admin password — this is what you'll type in to log in to /admin
ADMIN_PASSWORD=choose-a-password

# Make up a long random string (any text, the longer/messier the better) —
# this is used only to sign your login cookie, you never type it in anywhere
ADMIN_SESSION_SECRET=choose-a-long-random-string
